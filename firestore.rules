rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: pvd_records
// Document ID: {recordId} (string, 1..64 chars, e.g., '2026-Q3')
// Fields:
//   - id: string (required, 1..64 chars, immutable on update) - unique statement identifier
//   - statementDate: string (required, 1..32 chars) - statement date (YYYY-MM-DD or DD/MM/YYYY)
//   - statementDateDisplay: string (optional, 0..32 chars) - formatted AD date string
//   - statementDateThai: string (optional, 0..32 chars) - formatted BE date string
//   - quarter: number (required, 1..4) - statement quarter (Q1..Q4)
//   - year: number (required, 2000..2100) - statement AD year
//   - thaiYear: number (optional, 2400..2700) - statement BE year
//   - documentNo: string (optional, 0..64 chars) - statement document number
//   - planCode: string (optional, 0..64 chars) - investment plan code
//   - planName: string (optional, 0..256 chars) - investment plan name (EN)
//   - planNameTh: string (optional, 0..256 chars) - investment plan name (TH)
//   - memberContribution: number (required) - ending member contribution balance
//   - memberEarnings: number (required) - ending member earnings balance
//   - employerContribution: number (required) - ending employer contribution balance
//   - employerEarnings: number (required) - ending employer earnings balance
//   - totalMemberPortion: number (required) - total member balance
//   - totalEmployerPortion: number (required) - total employer balance
//   - totalBalance: number (required) - grand total PVD balance
//   - returnRate: number (optional, -1000..10000) - YTD return rate percentage
//   - prevYear: map (optional, 5 keys) - previous year movement breakdown
//   - ytd: map (optional, 5 keys) - year-to-date movement breakdown
//   - policies: list (optional, max 20 items) - sub-fund policy breakdown
//   - updatedAt: string or timestamp (optional, max 64 chars if string) - last modified timestamp
//
// Collection: pvd_settings
// Document ID: {settingId} (enum: 'profile' | 'retirement_goal')
// Fields:
//   - Bounded configuration map (1..20 keys) for member profile or retirement goal parameters
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is owner based on document's uid field
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate that a list is a list and enforces size limits
    function isValidList(list, maxSize) {
      return list is list && list.size() <= maxSize;
    }

    // Validate that a map contains only allowed keys
    function isValidMap(mapData, allowedKeys) {
      return mapData is map && mapData.keys().hasOnly(allowedKeys);
    }

    // Validate that immutable fields have not changed on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Inlined to stay well under Firestore's 20-call limit)
    // ===============================================================

    function isValidPVDRecord(data, recordId) {
      let requiredFields = [
        'id',
        'statementDate',
        'quarter',
        'year',
        'memberContribution',
        'memberEarnings',
        'employerContribution',
        'employerEarnings',
        'totalMemberPortion',
        'totalEmployerPortion',
        'totalBalance'
      ];
      let allowedFields = [
        'id',
        'statementDate',
        'statementDateDisplay',
        'statementDateThai',
        'quarter',
        'year',
        'thaiYear',
        'documentNo',
        'planCode',
        'planName',
        'planNameTh',
        'memberContribution',
        'memberEarnings',
        'employerContribution',
        'employerEarnings',
        'totalMemberPortion',
        'totalEmployerPortion',
        'totalBalance',
        'returnRate',
        'prevYear',
        'ytd',
        'policies',
        'updatedAt'
      ];
      let movementKeys = [
        'memberContribution',
        'memberEarnings',
        'employerContribution',
        'employerEarnings',
        'total'
      ];
      return recordId.size() >= 1 &&
        recordId.size() <= 64 &&
        data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.statementDate is string && data.statementDate.size() >= 1 && data.statementDate.size() <= 32 &&
        data.quarter is number && data.quarter >= 1 && data.quarter <= 4 &&
        data.year is number && data.year >= 2000 && data.year <= 2100 &&
        data.memberContribution is number && data.memberContribution >= -1000000000 && data.memberContribution <= 1000000000 &&
        data.memberEarnings is number && data.memberEarnings >= -1000000000 && data.memberEarnings <= 1000000000 &&
        data.employerContribution is number && data.employerContribution >= -1000000000 && data.employerContribution <= 1000000000 &&
        data.employerEarnings is number && data.employerEarnings >= -1000000000 && data.employerEarnings <= 1000000000 &&
        data.totalMemberPortion is number && data.totalMemberPortion >= -1000000000 && data.totalMemberPortion <= 1000000000 &&
        data.totalEmployerPortion is number && data.totalEmployerPortion >= -1000000000 && data.totalEmployerPortion <= 1000000000 &&
        data.totalBalance is number && data.totalBalance >= -1000000000 && data.totalBalance <= 1000000000 &&
        (!('statementDateDisplay' in data) || data.statementDateDisplay == null || (data.statementDateDisplay is string && data.statementDateDisplay.size() <= 32)) &&
        (!('statementDateThai' in data) || data.statementDateThai == null || (data.statementDateThai is string && data.statementDateThai.size() <= 32)) &&
        (!('thaiYear' in data) || data.thaiYear == null || (data.thaiYear is number && data.thaiYear >= 2400 && data.thaiYear <= 2700)) &&
        (!('documentNo' in data) || data.documentNo == null || (data.documentNo is string && data.documentNo.size() <= 64)) &&
        (!('planCode' in data) || data.planCode == null || (data.planCode is string && data.planCode.size() <= 64)) &&
        (!('planName' in data) || data.planName == null || (data.planName is string && data.planName.size() <= 256)) &&
        (!('planNameTh' in data) || data.planNameTh == null || (data.planNameTh is string && data.planNameTh.size() <= 256)) &&
        (!('returnRate' in data) || data.returnRate == null || (data.returnRate is number && data.returnRate >= -1000 && data.returnRate <= 10000)) &&
        (!('prevYear' in data) || data.prevYear == null || (data.prevYear is map && data.prevYear.keys().hasOnly(movementKeys) && data.prevYear.total is number)) &&
        (!('ytd' in data) || data.ytd == null || (data.ytd is map && data.ytd.keys().hasOnly(movementKeys) && data.ytd.total is number)) &&
        (!('policies' in data) || data.policies == null || (data.policies is list && data.policies.size() <= 20)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp);
    }

    function isValidPVDSetting(settingId, data) {
      return settingId in ['profile', 'retirement_goal'] &&
        data is map &&
        data.keys().size() >= 1 &&
        data.keys().size() <= 20 &&
        (!('memberName' in data) || data.memberName == null || (data.memberName is string && data.memberName.size() <= 128)) &&
        (!('employeeCode' in data) || data.employeeCode == null || (data.employeeCode is string && data.employeeCode.size() <= 64)) &&
        (!('memberCode' in data) || data.memberCode == null || (data.memberCode is string && data.memberCode.size() <= 64)) &&
        (!('referenceCode' in data) || data.referenceCode == null || (data.referenceCode is string && data.referenceCode.size() <= 64)) &&
        (!('departmentCode' in data) || data.departmentCode == null || (data.departmentCode is string && data.departmentCode.size() <= 64)) &&
        (!('employerName' in data) || data.employerName == null || (data.employerName is string && data.employerName.size() <= 256)) &&
        (!('employerNameTh' in data) || data.employerNameTh == null || (data.employerNameTh is string && data.employerNameTh.size() <= 256)) &&
        (!('fundNameTh' in data) || data.fundNameTh == null || (data.fundNameTh is string && data.fundNameTh.size() <= 256)) &&
        (!('fundNameEn' in data) || data.fundNameEn == null || (data.fundNameEn is string && data.fundNameEn.size() <= 256)) &&
        (!('registrationNo' in data) || data.registrationNo == null || (data.registrationNo is string && data.registrationNo.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp) &&
        (!('currentAge' in data) || (data.currentAge is number && data.currentAge >= 18 && data.currentAge <= 100)) &&
        (!('retirementAge' in data) || (data.retirementAge is number && data.retirementAge >= 30 && data.retirementAge <= 100)) &&
        (!('expectedAnnualReturn' in data) || (data.expectedAnnualReturn is number && data.expectedAnnualReturn >= -50 && data.expectedAnnualReturn <= 100)) &&
        (!('annualContributionGrowth' in data) || (data.annualContributionGrowth is number && data.annualContributionGrowth >= -50 && data.annualContributionGrowth <= 100)) &&
        (!('targetAmount' in data) || (data.targetAmount is number && data.targetAmount >= 0 && data.targetAmount <= 10000000000));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Quarterly PVD statement documents
    match /pvd_records/{recordId} {
      allow read: if true;
      allow create: if isValidPVDRecord(request.resource.data, recordId);
      allow update: if isValidPVDRecord(request.resource.data, recordId) &&
                       areImmutableFieldsUnchanged(['id']);
      allow delete: if recordId.size() >= 1 && recordId.size() <= 64;
    }

    // App configuration documents (member profile & retirement goal settings)
    match /pvd_settings/{settingId} {
      allow read: if true;
      allow create: if isValidPVDSetting(settingId, request.resource.data);
      allow update: if isValidPVDSetting(settingId, request.resource.data);
      allow delete: if settingId in ['profile', 'retirement_goal'];
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
